[gd_scene format=3]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.035, 0.055, 1)

[node name="Content" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Labels" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Title" type="Label" parent="Content/Labels"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.92, 0.9, 1)
theme_override_font_sizes/font_size = 48
text = "LANDZONE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Content/Labels"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.76, 0.82, 1)
theme_override_font_sizes/font_size = 22
text = "Project foundation"
horizontal_alignment = 1
